generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"  
}

model Tenant {
  id        String     @id @default(uuid())
  name      String
  investors Investor[]
}

model Investor {
  id          String        @id @default(uuid())
  tenant_id   String
  email       String        @unique
  kyc_status  String        @default("pending")
  tenant      Tenant        @relation(fields: [tenant_id], references: [id])
  webhookEvents WebhookEvent[]
}

model WebhookEvent {
  id           String   @id @default(uuid())
  event_id     String   @unique
  provider     String
  payload      Json
  processed_at DateTime @default(now())
  investor_id  String
  investor     Investor @relation(fields: [investor_id], references: [id])
  @@index([investor_id, processed_at])
}